{
  "name": "tired-dev",
  "version": "0.10.0",
  "description": "疲れたエンジニアが一読で理解できる日本語の技術文書を書くための規約です。SessionStart で適用対象を通知し、UserPromptSubmit が文章作成・推敲の依頼を検出したときに要約を注入します。PreToolUse が gh pr create / edit と Linear への保存の直前に本文を検査し、違反や意味の取れない語があれば投稿を止めます。チャット返答の口調には干渉しません。規約の全文は SKILL.md にあります。",
  "author": {
    "name": "malanjp",
    "url": "https://github.com/malanjp"
  },
  "homepage": "https://github.com/malanjp/skills",
  "repository": "https://github.com/malanjp/skills",
  "license": "MIT",
  "keywords": [
    "japanese",
    "日本語",
    "writing",
    "technical-writing",
    "cognitive-load",
    "proofreading",
    "issue",
    "code-review",
    "hooks",
    "skills"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/activate.js\"",
            "timeout": 5,
            "statusMessage": "tired-dev 読込中..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.js\"",
            "timeout": 5,
            "statusMessage": "tired-dev 判定中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-lint.js\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*__save_(issue|comment|document)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/linear-lint.js\"",
            "timeout": 60,
            "statusMessage": "tired-dev 検査中..."
          }
        ]
      }
    ]
  }
}
